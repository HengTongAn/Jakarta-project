# Local ComputerStore configuration template.
# Copy to .env and replace the placeholders; .env is git-ignored.
#
# NOTE: Java does not read .env files automatically. Load them into the
# process environment in your Tomcat/IDE launch configuration, for example in
# zsh:   set -a; source .env; set +a
# For deployments, put the same values in Tomcat's setenv.sh and chmod 600 it.
# Full reference: docs/deployment/configuration.md
#                  docs/deployment/local-development.md

DB_URL=jdbc:mysql://localhost:3306/computer_store?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=UTF-8
DB_USERNAME=store_user
DB_PASSWORD=replace-with-a-local-secret

# Optional: HikariCP pool sizing (defaults: maximumPoolSize=50, minimumIdle=10).
# DB_POOL_MAX=50
# DB_POOL_MIN=10

# Required only if you enable two-factor authentication. Generate a secure
# Base64 AES-256 key and keep it stable after users enroll:
#   openssl rand -base64 32
# COMPUTERSTORE_2FA_ENCRYPTION_KEY=

# --- Email (password reset codes) -------------------------------------------
# Required for password recovery to work at all. Both the 6-digit code flow
# (/forgot -> /verify-code -> /new-password) and the single-use link flow mail
# through this. Without MAIL_FROM and MAIL_USERNAME the app still runs, and
# /forgot shows a warning saying so rather than pretending a code was sent.
#
# For Gmail use an APP PASSWORD, not your account password: Google requires
# 2-Step Verification to be on, and the app password is the 16-character code
# generated at https://myaccount.google.com/apppasswords
# Delivery uses STARTTLS on port 587 and verifies the server certificate.
MAIL_SMTP_HOST=smtp.gmail.com
MAIL_SMTP_PORT=587
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# The address that sends the mail. For Gmail this must be the same address as
# MAIL_USERNAME, otherwise the message is rejected as spoofed.
MAIL_FROM=your.address@gmail.com
MAIL_USERNAME=your.address@gmail.com
MAIL_PASSWORD=your-16-character-app-password

# Optional: base directory for uploaded product images / avatars (kept outside
# the exploded webapp so redeploys do not delete them).
# COMPUTERSTORE_UPLOAD_DIR=~/.computerstore/uploads