{
  "name": "Apach_PC/STORE",
  "short_name": "Apach PC",
  "description": "Computer hardware storefront: browse the catalogue, manage your cart, and track your orders.",
  "lang": "en",
  "dir": "ltr",

  "_comment_paths": "start_url, scope and every icon src are RELATIVE on purpose. This app is deployed under a context path (/computerstore), and a manifest resolves its URLs against the manifest's own URL. An absolute '/products' would resolve to the server root and 404; './products' resolves to <context>/products and keeps the file portable across context paths, including running at the root of a different host.",

  "start_url": "./products",
  "scope": "./",
  "id": "./products",

  "display": "standalone",
  "display_override": ["standalone", "minimal-ui", "browser"],
  "orientation": "portrait-primary",

  "theme_color": "#0f172a",
  "background_color": "#f8fafc",

  "categories": ["shopping", "business"],
  "prefer_related_applications": false,

  "icons": [
    {
      "src": "./assets/images/icons/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/images/icons/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "./assets/images/icons/icon-maskable-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "./assets/images/icons/icon-maskable-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "shortcuts": [
    {
      "name": "Shopping cart",
      "short_name": "Cart",
      "url": "./cart",
      "icons": [{ "src": "./assets/images/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "My orders",
      "short_name": "Orders",
      "url": "./account/orders",
      "icons": [{ "src": "./assets/images/icons/icon-192.png", "sizes": "192x192" }]
    },
    {
      "name": "Browse products",
      "short_name": "Shop",
      "url": "./products",
      "icons": [{ "src": "./assets/images/icons/icon-192.png", "sizes": "192x192" }]
    }
  ]
}
