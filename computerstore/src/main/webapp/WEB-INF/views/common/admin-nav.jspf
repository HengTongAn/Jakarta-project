<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="_sp" value="${empty requestScope['jakarta.servlet.forward.servlet_path'] ? pageContext.request.servletPath : requestScope['jakarta.servlet.forward.servlet_path']}"/>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-1 admin-nav">
    <div class="container d-flex align-items-center gap-2">
        <span class="admin-brand d-flex align-items-center gap-2 me-1" aria-label="TechStore admin panel">
            <img src="${pageContext.request.contextPath}/assets/images/techstore-mark.svg" alt="TechStore" style="height:22px;width:auto">
            <span class="fw-semibold">Admin Panel</span>
        </span>
        <span class="admin-nav-label d-none d-xl-inline">Manage your store</span>
        <div class="navbar-nav flex-row flex-nowrap gap-1 ms-1 admin-nav-scroll">
            <a class="nav-link${_sp == '/admin' ? ' active' : ''}"${_sp == '/admin' ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin">Dashboard</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/products') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/products') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/products">Products</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/categories') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/categories') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/categories">Categories</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/brands') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/brands') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/brands">Brands</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/inventory') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/inventory') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/inventory">Inventory</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/orders') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/orders') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/orders">Orders</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/users') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/users') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/users">Users</a>
            <a class="nav-link position-relative${fn:startsWith(_sp, '/admin/mail') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/mail') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/mail">
                Mail
                <span class="badge bg-danger rounded-pill mail-live-count<c:if test="${empty mailCount || mailCount == 0}"> d-none</c:if>">${mailCount}</span>
            </a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/history') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/history') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/history">History</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/reports') ? ' active' : ''}"${fn:startsWith(_sp, '/admin/reports') ? ' aria-current="page"' : ''} href="${pageContext.request.contextPath}/admin/reports">Reports</a>
        </div>
    </div>
</nav>
