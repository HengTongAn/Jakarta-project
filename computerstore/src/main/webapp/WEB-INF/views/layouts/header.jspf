<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<%@ taglib prefix="fmt" uri="jakarta.tags.fmt" %>
<%@ page import="com.hengtongan.computerstore.util.security.CSRFUtil" %>
<%
    // CSRF token for this session, cached in request scope. First render of
    // the page touches the session once; every later include within the same
    // request (footer forms, JS setup, etc.) reuses the request-scoped value
    // instead of re-entering the session's monitor lock per include.
    String csrfToken = (String) request.getAttribute("csrfToken");
    if (csrfToken == null) {
        csrfToken = CSRFUtil.generateToken(session);
        request.setAttribute("csrfToken", csrfToken);
    }

    // Cache-busting version for static assets: the newest last-modified time
    // across the app's stylesheets (changes on every deploy), cached in
    // application scope. App CSS is split into layers under /assets/css/app/.
    Long assetsVersion = (Long) application.getAttribute("assetsVersion");
    if (assetsVersion == null) {
        try {
            // App JS is versioned too, not just CSS: without it a redeploy can
            // leave the browser running a stale app.js, which is indistinguishable
            // from a code bug. The same holds now that the service worker keys
            // its cache on the full URL: a file missing from this list keeps the
            // same ?v= value across deploys that change only that file, so both
            // the HTTP cache and the worker keep serving the old bytes.
            //
            // Every asset referenced with ?v=${assetsVersion} must appear here.
            // AssetsVersionCoverageTest fails when one does not.
            String[] appAssets = { "/assets/css/app/variables.css", "/assets/css/app/base.css",
                    "/assets/css/app/layout.css", "/assets/css/app/components.css",
                    "/assets/css/app/pages.css", "/assets/css/app/theme.css",
                    "/assets/vendor/bootstrap/bootstrap.min.css",
                    "/assets/vendor/bootstrap/bootstrap.bundle.min.js",
                    "/assets/vendor/bootstrap-icons/bootstrap-icons.min.css",
                    "/assets/vendor/chart.js/chart.umd.min.js",
                    "/assets/js/admin-help.js", "/assets/js/dropdown-hover.js",
                    "/assets/js/app.js", "/assets/js/dashboard-live.js",
                    "/assets/js/password-toggle.js",
                    "/assets/js/performance-live.js",
                    "/assets/js/product-spec-editor.js", "/assets/js/pwa.js",
                    "/assets/js/hero-pc-carousel.js", "/assets/js/realtime.js", "/assets/js/reports-live.js",
                    "/assets/js/rum.js", "/assets/js/theme.js" };
            long v = 0;
            for (String path : appAssets) {
                java.net.URL asset = application.getResource(path);
                if (asset != null) {
                    v = Math.max(v, asset.openConnection().getLastModified());
                }
            }
            assetsVersion = v > 0 ? v : System.currentTimeMillis();
        } catch (Exception ignored) {
            assetsVersion = System.currentTimeMillis();
        }
        application.setAttribute("assetsVersion", assetsVersion);
    }
    request.setAttribute("assetsVersion", assetsVersion);
%>
<%--
    Pin the locale that JSTL's fmt: tags format with, before any view uses one.

    Without this, every fmt:formatNumber / fmt:formatDate in the app renders
    raw Object.toString() output. The JSTL build this app ships (Apache
    Taglibs Standard repackaged under the jakarta.tags.* URIs) returns null
    from getFormattingLocale when no locale was ever set, and
    FormatNumberSupport.doEndTag branches on exactly that:

        150: getFormattingLocale(pageContext, this, true, true)
        154: aload_3
        155: ifnull 288      <- 288 is Object.toString()

    A null locale is not treated as an error, so the page still returns 200 and
    every pattern, type and maxFractionDigits is silently discarded. This was
    live for the whole life of the app: all 107 fmt:formatNumber calls across
    the views were unformatted, so page weight read "87.0939453125 KB" instead
    of "87.1 KB". Values looked plausible on most pages only because most of
    them are integers.

    There is no system-property escape hatch. SetLocaleSupport in this build
    never calls System.getProperty, so a -Djakarta.servlet.jsp.jstl.fmt.locale
    flag is read by nothing and the numbers stay unformatted.

    Declared above despite 25 views also declaring the fmt prefix: static
    includes merge into one translation unit, and the redeclaration is
    harmless. LocaleFormatTest fails the build if this line is removed.
--%>
<fmt:setLocale value="en_US"/>
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title><c:out value="${empty pageTitle ? 'Apach_PC/STORE' : pageTitle}"/></title>
    <script>
        /* FOUC-safe theme boot: apply the saved (or OS-preferred) scheme
           before the stylesheets paint so the page never flashes light-ven.
           theme.js wires the toggle and stays in sync; the saved value wins
           until the user clears it, then the OS preference applies. */
        (function () {
            var root = document.documentElement;
            var theme = null;
            try { theme = localStorage.getItem('computerstore.theme'); } catch (e) {}
            if (theme !== 'light' && theme !== 'dark') {
                theme = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
            }
            root.setAttribute('data-bs-theme', theme);
            root.style.colorScheme = theme;
        })();
    </script>
    <%-- PWA / install-to-home-screen. The manifest paths are relative so they
         resolve against this app's context path, not the server root. --%>
    <link rel="manifest" href="${pageContext.request.contextPath}/manifest.webmanifest">
    <meta name="theme-color" content="#0f172a">
    <meta name="mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="apple-mobile-web-app-title" content="Apach PC">
    <meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
    <link rel="icon" type="image/svg+xml" href="${pageContext.request.contextPath}/assets/images/apach-pc-store.svg">
    <%-- iOS ignores an SVG apple-touch-icon and falls back to a screenshot of
         the page, so the installed icon must be a real PNG. --%>
    <link rel="apple-touch-icon" type="image/png" sizes="180x180" href="${pageContext.request.contextPath}/assets/images/icons/apple-touch-icon.png">
    <link href="${pageContext.request.contextPath}/assets/vendor/bootstrap/bootstrap.min.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/vendor/bootstrap-icons/bootstrap-icons.min.css?v=${assetsVersion}" rel="stylesheet">
    <%-- App stylesheets - LAYER ORDER MATTERS: tokens -> base -> layout ->
         components -> pages -> theme. Each layer may only refine earlier
         layers; the theme layer (dark mode, responsive, motion) loads last so
         it always wins. Edit files under /assets/css/app/ (+README). --%>
    <link href="${pageContext.request.contextPath}/assets/css/app/variables.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app/base.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app/layout.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app/components.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app/pages.css?v=${assetsVersion}" rel="stylesheet">
    <link href="${pageContext.request.contextPath}/assets/css/app/theme.css?v=${assetsVersion}" rel="stylesheet">
    <script>window.CTXPATH = '${pageContext.request.contextPath}';</script>
    <script>window.CSRFTOKEN = '${csrfToken}';</script>
    <%-- Page type for real-user monitoring, set by ExperienceFilter and absent on
         anything that is not a page view (static assets, /health, the SSE stream,
         404s). rum.js reports the browser's own navigation timings against it.
         Rendered into the page rather than sent as a response header because the
         Navigation Timing API cannot read response headers, so a header-based
         version would report nothing at all while looking correct. PageType
         generates this value from the servlet mapping and sanitises it to
         [a-z0-9/_\-:.], so interpolating it into a script is safe. --%>
    <c:if test="${not empty requestScope.pageExperienceType}"><script>window.__EPT_PT = '${requestScope.pageExperienceType}';</script></c:if>
    <script defer src="${pageContext.request.contextPath}/assets/js/theme.js?v=${assetsVersion}"></script>
    <script defer src="${pageContext.request.contextPath}/assets/js/pwa.js?v=${assetsVersion}"></script>
    <script defer src="${pageContext.request.contextPath}/assets/js/rum.js?v=${assetsVersion}"></script>
    <%-- Hover-to-open for every dropdown: the admin sub-nav's four groups and the
         profile menu above, which is the one dropdown a customer gets and an admin
         gets too. Loaded here rather than next to either menu because this
         fragment is the only one present on every page, admin and customer alike.
         Guarded to real pointers inside the script, so touch keeps click-to-open. --%>
    <script defer src="${pageContext.request.contextPath}/assets/js/dropdown-hover.js?v=${assetsVersion}"></script>
</head>
<body class="d-flex flex-column min-vh-100 ${empty bodyClass ? '' : bodyClass}" data-userid="${sessionScope.user != null ? sessionScope.user.userId : ''}">
<c:set var="_sp" value="${empty requestScope['jakarta.servlet.forward.servlet_path'] ? pageContext.request.servletPath : requestScope['jakarta.servlet.forward.servlet_path']}"/>
<c:if test="${not empty sessionScope.flashMessage}">
    <c:set var="_flashType" value="${empty sessionScope.flashType ? 'success' : sessionScope.flashType}"/>
    <div id="toastStack" class="toast-stack" role="presentation">
        <div class="ux-toast ux-toast-${_flashType}" role="status" aria-live="polite">
            <i class="bi ${_flashType == 'danger' ? 'bi-x-circle-fill' : _flashType == 'warning' ? 'bi-exclamation-triangle-fill' : 'bi-check-circle-fill'}" aria-hidden="true"></i>
            <span class="ux-toast-msg"><c:out value="${sessionScope.flashMessage}"/></span>
            <button type="button" class="btn-close ux-toast-close" data-dismiss-toast aria-label="Close"></button>
        </div>
    </div>
    <c:remove var="flashMessage" scope="session"/>
    <c:remove var="flashType" scope="session"/>
</c:if>
<a class="skip-link" href="#main-content">Skip to main content</a>
<div id="scrollProgress" class="scroll-progress" role="progressbar" aria-label="Page reading progress" aria-valuemin="0" aria-valuemax="100" aria-valuenow="0"></div>
<nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top site-topbar">
    <div class="container">
        <%-- The brand goes home: the storefront for a shopper, the panel for an admin. Both
             targets are reachable by their own role, so the logo is never a 403. --%>
        <a class="navbar-brand fw-bold d-flex align-items-center gap-2" href="${pageContext.request.contextPath}${sessionScope.user.isAdmin() ? '/admin' : '/products'}" aria-label="Apach_PC/STORE home">
            <img class="brand-logo" src="${pageContext.request.contextPath}/assets/images/apach-pc-store.svg" alt="Apach_PC/STORE logo">
            <span class="brand-txt">Apach_PC/STORE</span>
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#mainNav" aria-controls="mainNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse" id="mainNav">
            <div class="me-auto"></div>
            <ul class="navbar-nav align-items-lg-center">
                <li class="nav-item nav-theme-item d-flex align-items-center">
                    <button type="button" class="btn btn-outline-light btn-sm nav-admin-btn nav-theme-btn"
                            data-theme-toggle aria-label="Switch to dark mode" title="Switch to dark mode">
                        <i class="bi bi-moon-stars" aria-hidden="true"></i>
                    </button>
                </li>
                <c:if test="${sessionScope.user.isAdmin()}">
                    <li class="nav-item">
                        <a class="btn btn-outline-light btn-sm nav-admin-btn${fn:startsWith(_sp, '/admin') ? ' active' : ''}"
                           href="${pageContext.request.contextPath}/admin">
                            <i class="bi bi-grid" aria-hidden="true"></i> Admin
                        </a>
                    </li>
                </c:if>
                <%-- Hidden for admins on every page, not just /admin*. StorefrontAccessFilter
                     answers an admin's /products with 403, so a visible Shop button would be a
                     dead link. sessionScope.user.isAdmin() is false for a null user (EL yields
                     null, and `not null` is true), which is what keeps it visible to shoppers
                     and to anonymous visitors. --%>
                <c:if test="${not sessionScope.user.isAdmin()}">
                <li class="nav-item">
                    <a class="btn btn-outline-light btn-sm nav-admin-btn nav-shop-btn${_sp == '/products' ? ' active' : ''}"
                       href="${pageContext.request.contextPath}/products"${_sp == '/products' ? ' aria-current="page"' : ''}>
                        <i class="bi bi-bag-fill" aria-hidden="true"></i><span>Shop</span>
                    </a>
                </li>
                </c:if>
                <c:choose>
                    <c:when test="${not empty sessionScope.user}">
                        <%-- Hidden for admins on every page. The badge stays meaningful: it is
                             fed by CartCountFilter, which is mapped /* and still counts for every
                             session, so a customer who also holds an admin account sees their own
                             cart rather than an empty badge. --%>
                        <c:if test="${not sessionScope.user.isAdmin()}">
                        <li class="nav-item">
                            <a class="btn btn-outline-light btn-sm nav-admin-btn nav-cart-btn position-relative${_sp == '/cart' ? ' active' : ''}" href="${pageContext.request.contextPath}/cart">
                                <i class="bi bi-cart3"></i> <span class="d-none d-lg-inline">Cart</span>
                                <span id="cartCountBadge" class="badge bg-danger rounded-pill ${cartCount > 0 ? '' : 'd-none'}" aria-label="${cartCount} items in cart">${cartCount}</span>
                            </a>
                        </li>
                        </c:if>
                        <li class="nav-item dropdown dropdown-hover">
                            <a class="btn btn-outline-light btn-sm nav-admin-btn nav-profile-btn dropdown-toggle" href="#" data-bs-toggle="dropdown" role="button" aria-expanded="false">
                                <div class="nav-profile-content">
                                    <div class="nav-profile-avatar" aria-hidden="true">
                                        <c:choose>
                                            <c:when test="${not empty sessionScope.user.avatarUrl}">
                                                <img src="${pageContext.request.contextPath}/${sessionScope.user.avatarUrl}" class="nav-avatar" alt="">
                                            </c:when>
                                            <c:otherwise><i class="bi bi-person-circle nav-avatar-placeholder"></i></c:otherwise>
                                        </c:choose>
                                    </div>
                                    <div class="nav-profile-name"><c:out value="${fn:replace(sessionScope.user.fullName, ' Customer', '')}"/></div>
                                </div>
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end dropdown-hover-menu">
                                <c:if test="${sessionScope.user.role.name() == 'CUSTOMER'}">
                                    <li><a class="dropdown-item${_sp == '/account' ? ' active' : ''}" href="${pageContext.request.contextPath}/account"><i class="bi bi-person-circle me-2" aria-hidden="true"></i>My Account</a></li>
                                    <li><a class="dropdown-item${fn:startsWith(_sp, '/account/orders') ? ' active' : ''}" href="${pageContext.request.contextPath}/account/orders"><i class="bi bi-box-seam me-2" aria-hidden="true"></i>My Orders</a></li>
                                    <li><a class="dropdown-item${fn:startsWith(_sp, '/account/transactions') ? ' active' : ''}" href="${pageContext.request.contextPath}/account/transactions"><i class="bi bi-currency-dollar me-2" aria-hidden="true"></i>Transactions</a></li>
                                    <li><a class="dropdown-item${_sp == '/account/settings' ? ' active' : ''}" href="${pageContext.request.contextPath}/account/settings"><i class="bi bi-shield-lock me-2" aria-hidden="true"></i>Security</a></li>
                                </c:if>
                                <li><a class="dropdown-item${fn:startsWith(_sp, '/account/profile') ? ' active' : ''}" href="${pageContext.request.contextPath}/account/profile"><i class="bi bi-person-vcard me-2" aria-hidden="true"></i>Profile</a></li>
                                <%-- Admin History (the audit_logs window) lives here rather than in
                                     the admin sub-nav. It is a Settings/Security destination in
                                     every mainstream panel: something you open to answer "who
                                     did what and when", not a place you go to work. Fourteen
                                     top-level admin links did not fit the nav port at 1280px;
                                     grouping them into five does, and this was the one item
                                     with no daily use. Gated on isAdmin because the servlet is,
                                     and the store has no admin settings page to nest it under
                                     yet. --%>
                                <c:if test="${sessionScope.user.isAdmin()}">
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item${fn:startsWith(_sp, '/admin/history') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/history"><i class="bi bi-clock-history me-2" aria-hidden="true"></i>Admin History</a></li>
                                </c:if>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" action="${pageContext.request.contextPath}/logout">
                                        <input type="hidden" name="csrfToken" value="${csrfToken}">
                                        <button type="submit" class="dropdown-item text-danger"><i class="bi bi-box-arrow-right me-2" aria-hidden="true"></i>Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    </c:when>
                    <c:otherwise>
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm nav-admin-btn nav-login-btn${_sp == '/login' ? ' active' : ''}" href="${pageContext.request.contextPath}/login"${_sp == '/login' ? ' aria-current="page"' : ''}>Login</a></li>
                        <li class="nav-item"><a class="btn btn-outline-light btn-sm nav-admin-btn nav-register-btn${_sp == '/register' ? ' active' : ''}" href="${pageContext.request.contextPath}/register"${_sp == '/register' ? ' aria-current="page"' : ''}>Register</a></li>
                    </c:otherwise>
                </c:choose>
            </ul>
        </div>
    </div>
</nav>
<main id="main-content" class="page-shell">
