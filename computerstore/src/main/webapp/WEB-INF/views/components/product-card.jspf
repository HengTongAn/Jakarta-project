<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%-- Reusable product card. Expects ${p} (a ProductCardVM) in scope. --%>
<div class="card product-card h-100">
    <a href="${pageContext.request.contextPath}/products?id=${p.productId}" class="product-media text-decoration-none">
        <c:choose>
            <c:when test="${p.hasImage()}">
                <img loading="lazy" decoding="async" src="${pageContext.request.contextPath}/${p.imageUrl}" alt="<c:out value='${p.name}'/>">
            </c:when>
            <c:otherwise>
                <svg class="icon-ph" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 16 16" fill="currentColor">
                    <path d="M13 1a1 1 0 0 1 1 1v10a1 1 0 0 1-1 1H9v2h2a.5.5 0 0 1 0 1H5a.5.5 0 0 1 0-1h2v-2H3a1 1 0 0 1-1-1V2a1 1 0 0 1 1-1h10z"/>
                </svg>
            </c:otherwise>
        </c:choose>
    </a>
    <div class="card-body">
        <c:if test="${not empty p.brandName}">
            <p class="p-brand mb-0"><c:out value="${p.brandName}"/></p>
        </c:if>
        <h6 class="p-title">
            <a href="${pageContext.request.contextPath}/products?id=${p.productId}">
                <c:out value="${p.name}"/>
            </a>
        </h6>
        <p class="p-meta mb-0">
            <c:out value="${p.categoryName}"/>
        </p>
        <c:if test="${p.hasReviews()}">
            <div class="p-rating">
                <span class="stars text-warning" aria-hidden="true">
                    <c:forEach begin="1" end="${p.displayStars}">&#9733;</c:forEach><c:forEach begin="${p.displayStars + 1}" end="5">&#9734;</c:forEach>
                </span>
                <span class="text-muted">${p.average} (${p.reviewCount})</span>
            </div>
        </c:if>
        <div class="p-buy">
            <span class="product-price money">$<fmt:formatNumber value="${p.price}" pattern="#,##0.00"/></span>
            <span class="p-stock p-stock-${p.status.name() == 'OUT_OF_STOCK' ? 'out' : p.status.name() == 'LOW_STOCK' ? 'low' : 'in'}" data-stock-for="${p.productId}">
                <span class="dot"></span>
                <c:choose>
                    <c:when test="${p.status.name() == 'OUT_OF_STOCK'}">Out of stock</c:when>
                    <c:when test="${p.status.name() == 'LOW_STOCK'}">Only ${p.stockQuantity} left</c:when>
                    <c:otherwise>In stock</c:otherwise>
                </c:choose>
            </span>
        </div>
    </div>
    <div class="card-footer">
        <c:choose>
            <c:when test="${empty sessionScope.user}">
                <a class="btn-add" href="${pageContext.request.contextPath}/login?return=/products%3Fid%3D${p.productId}">
                    <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                        <path d="M8 1a2 2 0 0 1 2 2v.5H4.5V3a2 2 0 0 1 2-2zM3.5 3.5V3a3 3 0 0 1 6 0v.5h.5A1.5 1.5 0 0 1 11.5 5v7A1.5 1.5 0 0 1 10 13.5H4A1.5 1.5 0 0 1 2.5 12V5A1.5 1.5 0 0 1 4 3.5z"/>
                    </svg>
                    Login to buy
                </a>
            </c:when>
            <c:otherwise>
                <%-- Always render the quick-add form (even when out of stock) so a
                     real-time restock can re-enable a button that actually submits.
                     When stock is 0 the submit button renders disabled ("Unavailable"). --%>
                <form method="post" action="${pageContext.request.contextPath}/cart/add" data-quickadd data-no-spinner>
                    <input type="hidden" name="csrfToken" value="${csrfToken}">
                    <input type="hidden" name="productId" value="${p.productId}">
                    <input type="hidden" name="quantity" value="1">
                    <c:choose>
                        <c:when test="${p.stockQuantity > 0}">
                            <button type="submit" class="btn-add" data-loading="Adding…">
                                <svg viewBox="0 0 16 16" fill="currentColor" aria-hidden="true">
                                    <path d="M0 1.5A.5.5 0 0 1 .5 1H2a.5.5 0 0 1 .485.379L2.89 3H14.5a.5.5 0 0 1 .491.592l-1.5 8A.5.5 0 0 1 13 12H4a.5.5 0 0 1-.491-.408L2.01 3.607 1.61 2H.5a.5.5 0 0 1-.5-.5zM5 12a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm7 0a2 2 0 1 0 0 4 2 2 0 0 0 0-4zm-7 1a1 1 0 1 1 0 2 1 1 0 0 1 0-2zm7 0a1 1 0 1 1 0 2 1 1 0 0 1 0-2z"/>
                                </svg>
                                Add to cart
                            </button>
                        </c:when>
                        <c:otherwise>
                            <button type="submit" class="btn-add" disabled>Unavailable</button>
                        </c:otherwise>
                    </c:choose>
                </form>
            </c:otherwise>
        </c:choose>
    </div>
</div>
