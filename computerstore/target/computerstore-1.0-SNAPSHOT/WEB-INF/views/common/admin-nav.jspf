<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ taglib prefix="c" uri="jakarta.tags.core" %>
<%@ taglib prefix="fn" uri="jakarta.tags.functions" %>
<c:set var="_sp" value="${pageContext.request.servletPath}"/>
<nav class="navbar navbar-expand-lg navbar-light bg-white border-bottom py-1 admin-nav">
    <div class="container">
        <span class="navbar-text fw-semibold me-3">Management</span>
        <div class="navbar-nav flex-row flex-wrap">
            <a class="nav-link${_sp == '/admin' ? ' active' : ''}" href="${pageContext.request.contextPath}/admin">Dashboard</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/products') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/products">Products</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/categories') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/categories">Categories</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/brands') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/brands">Brands</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/inventory') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/inventory">Inventory</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/orders') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/orders">Orders</a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/customers') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/customers">Customers</a>
            <a class="nav-link position-relative${fn:startsWith(_sp, '/admin/mail') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/mail">
                Mail
                <span class="badge bg-danger rounded-pill mail-live-count<c:if test="${empty mailCount || mailCount == 0}"> d-none</c:if>">${mailCount}</span>
            </a>
            <a class="nav-link${fn:startsWith(_sp, '/admin/reports') ? ' active' : ''}" href="${pageContext.request.contextPath}/admin/reports">Reports</a>
        </div>
    </div>
</nav>